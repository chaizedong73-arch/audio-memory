<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F5F5F7" Margin="22,18,22,18" MinWidth="760">
 <Grid.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,8" />
   <Setter Property="Margin" Value="6,0,0,0" />
   <Setter Property="Background" Value="#ECECEF" />
   <Setter Property="Foreground" Value="#303034" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="MinHeight" Value="34" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF" />
        <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FontSize" Value="14" />
   <Setter Property="Foreground" Value="#72727B" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="Tab" Padding="16,11" Background="Transparent" CornerRadius="8,8,0,0">
       <ContentPresenter ContentSource="Header" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Tab" Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#22232A" />
        <Setter Property="FontWeight" Value="SemiBold" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Tab" Property="BorderBrush" Value="#007AFF" />
        <Setter TargetName="Tab" Property="BorderThickness" Value="1" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabControl">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <TabPanel IsItemsHost="True" />
       <Border Grid.Row="1" Background="White" CornerRadius="0,8,8,8">
        <ContentPresenter ContentSource="SelectedContent" />
       </Border>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="FontWeight" Value="Normal" />
   <Setter Property="Background" Value="White" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="IsReadOnly" Value="True" />
   <Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="FontSize" Value="15" />
   <Setter Property="Padding" Value="20" />
   <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style x:Key="Metric" TargetType="Border">
   <Setter Property="Background" Value="White" />
   <Setter Property="CornerRadius" Value="12" />
   <Setter Property="Padding" Value="17,13" />
   <Setter Property="Margin" Value="0,0,10,0" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#72727B" />
   <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Value" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#22232A" />
   <Setter Property="FontSize" Value="21" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Margin" Value="0,5,0,3" />
  </Style>
 </Grid.Resources>
 <Grid.RowDefinitions>
  <RowDefinition Height="Auto" />
  <RowDefinition Height="*" />
  <RowDefinition Height="Auto" />
 </Grid.RowDefinitions>
 <Grid Margin="0,0,0,18">
  <Grid.ColumnDefinitions>
   <ColumnDefinition />
   <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <StackPanel>
   <TextBlock Text="录音记忆" FontSize="24" FontWeight="Normal" />
   <TextBlock Text="日常功能与课堂工作区" Foreground="#72727B" FontSize="14" Margin="0,5,0,0" />
  </StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
   <Button x:Name="CopyPath" Content="复制材料路径" />
   <Button x:Name="OpenFolder" Content="打开数据目录" />
   <Button x:Name="Refresh" Content="刷新" />
  </StackPanel>
 </Grid>
 <Grid Grid.Row="2" Margin="0,12,0,0">
  <Grid.ColumnDefinitions>
   <ColumnDefinition />
   <ColumnDefinition Width="Auto" />
  </Grid.ColumnDefinitions>
  <TextBlock x:Name="Feedback" Text="关闭工具箱会结束上课模式；常驻录音仍由工具箱启停。" Foreground="#72727B" FontSize="12" TextWrapping="Wrap" />
  <Button x:Name="CopyDiagnostic" Grid.Column="1" Content="复制诊断信息" Padding="10,4" MinHeight="26" />
 </Grid>
 <TabControl x:Name="WorkspaceTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0">
  <TabItem Header="日常功能" FontSize="16" x:Name="DailyWorkspaceTab">
   <Grid Background="#F5F5F7" Margin="0,14,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="14">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,-10,14">
     <Border Style="{StaticResource Metric}">
      <StackPanel>
       <TextBlock Text="录音采集" Style="{StaticResource Label}" />
       <TextBlock x:Name="Recording" Style="{StaticResource Value}" FontSize="24" Text="读取中" />
       <TextBlock x:Name="RecordingDetail" Style="{StaticResource Label}" Text="核对实际录音文件" TextWrapping="Wrap" />
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Metric}">
      <StackPanel>
       <TextBlock Text="转写方式" Style="{StaticResource Label}" />
       <StackPanel Orientation="Horizontal" Margin="0,8,0,5">
        <Button x:Name="UseLocal" Content="本地" Margin="0,0,6,0" />
        <Button x:Name="UseCloud" Content="大模型" Margin="0" ToolTip="豆包2.0Mini；每次最多3小时、估算停止线5元。切回本地停止新请求，已发出的请求可能仍计费。" />
       </StackPanel>
       <TextBlock x:Name="Model" Style="{StaticResource Value}" FontSize="15" Text="—" />
       <TextBlock x:Name="Latency" Style="{StaticResource Label}" Text="等待处理结果" TextWrapping="Wrap" />
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Metric}">
      <StackPanel>
       <TextBlock Text="本次大模型费用预估" Style="{StaticResource Label}" />
       <TextBlock x:Name="Cost" Style="{StaticResource Value}" Text="—" />
       <TextBlock x:Name="Deadline" Style="{StaticResource Label}" Text="包含请求预留，以账户账单为准" TextWrapping="Wrap" />
      </StackPanel>
     </Border>
    </UniformGrid>
    <Border Grid.Row="1" Background="#E8EEF5" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
     <TextBlock x:Name="Health" Text="正在读取本地状态…" Foreground="#3F566E" FontSize="13" TextWrapping="Wrap" />
    </Border>
    <TabControl x:Name="ContentTabs" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0">
     <TabItem Header="实时转写">
      <Grid Background="White">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <Grid Margin="18,13,18,9">
        <Grid.ColumnDefinitions>
         <ColumnDefinition />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TranscriptMeta" Text="读取最近课堂材料" Foreground="#72727B" FontSize="13" TextWrapping="Wrap" />
        <Button x:Name="Annotate" Grid.Column="1" Content="批注所选文字" ToolTip="用一句话描述修改要求，由2.0Mini理解修订；保存多条后统一提交，与转写方式独立。" IsEnabled="False" Padding="10,4" MinHeight="28" />
        <CheckBox x:Name="Follow" Grid.Column="2" Content="跟随最新" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" />
       </Grid>
       <TextBox x:Name="Transcript" Grid.Row="1" Text="尚未收到转写。" IsInactiveSelectionHighlightEnabled="True" SelectionBrush="#94B9F5" SelectionOpacity="0.6" />
      </Grid>
     </TabItem>
     <TabItem Header="修改批注">
      <Grid Background="White">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <Grid Margin="18,12,18,12">
        <Grid.ColumnDefinitions>
         <ColumnDefinition />
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="AnnotationStatus" Text="在正文中选择词句，添加修改意见后统一提交" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="RemoveAnnotation" Grid.Column="1" Content="移除所选批注" />
        <Button x:Name="SubmitAnnotations" Grid.Column="2" Content="提交全部批注" IsEnabled="False" />
       </Grid>
       <ListBox x:Name="Annotations" Grid.Row="1" BorderThickness="0" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="14" Margin="7,8" FontWeight="Normal" />
         </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
         </Style>
        </ListBox.ItemContainerStyle>
       </ListBox>
      </Grid>
     </TabItem>
     <TabItem Header="记忆结果">
      <Grid Background="White">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <TextBlock Margin="18,13,18,8" Text="记忆约十分钟整理一次；课堂实时内容请看“实时转写”。" Foreground="#72727B" FontSize="13" />
       <TextBox x:Name="Memory" Grid.Row="1" Text="今天尚未生成记忆结果。" />
      </Grid>
     </TabItem>
     <TabItem Header="字幕维护">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="22,18">
        <TextBlock Text="字幕维护 AI · 2.0Mini" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="常驻功能：核对字幕；上课模式开启时额外读取课程资料。每次最多3小时／估算5元，独立于转写费用。" TextWrapping="Wrap" Foreground="#72727B" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
         <Button x:Name="StartSubtitle" Content="启动字幕初筛" Margin="0,0,8,0" />
         <Button x:Name="PauseSubtitle" Content="停止字幕初筛" Margin="0" />
        </StackPanel>
        <TextBlock x:Name="SubtitleStatus" Text="未启动" TextWrapping="Wrap" Foreground="#56657A" Margin="0,8,0,22" />
        <Border x:Name="SubtitleConfirmation" Visibility="Collapsed" BorderBrush="#DDE4ED" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18" Background="#FAFBFE">
         <StackPanel>
          <TextBlock x:Name="SubtitleQuestion" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="SubtitleReason" FontSize="12" Foreground="#72727B" TextWrapping="Wrap" Margin="0,5,0,10" />
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <Button x:Name="RejectSubtitle" Content="×" ToolTip="驳回，保留原文" Margin="0,0,8,0" />
           <TextBox x:Name="SubtitleTerm" Grid.Column="1" IsReadOnly="False" Padding="10,6" BorderThickness="1" BorderBrush="#DDE4ED" FontSize="14" ToolTip="可直接修改候选符号，再点右侧确认" />
           <Button x:Name="AcceptSubtitle" Grid.Column="2" Content="√" ToolTip="确认并更新字幕" Background="#292D35" Foreground="White" />
          </Grid>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="运行日志">
      <Grid Background="White">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <DockPanel Margin="18,12,18,8">
        <TextBlock Text="查看日志" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="LogPicker" Width="260" HorizontalAlignment="Left" />
       </DockPanel>
       <TextBox x:Name="Logs" Grid.Row="1" FontFamily="Consolas, Microsoft YaHei" FontSize="13" />
      </Grid>
     </TabItem>
     <TabItem Header="情景" x:Name="ClassroomContextTab" Visibility="Collapsed">
      <StackPanel Margin="22,18" MaxWidth="860">
       <TextBlock Text="当前课堂情景" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
       <TextBlock Text="每10分钟检查近期字幕，有新内容时自动生成情景；确认前不会覆盖正式情景卡。" Foreground="#72727B" TextWrapping="Wrap" Margin="0,0,0,14" />
       <WrapPanel Margin="0,0,0,12"><Button x:Name="GenerateContext" Content="生成情景候选" Background="#292D35" Foreground="White" Margin="0,0,8,0" /><Button x:Name="OpenContextCandidate" Content="打开候选文件" /></WrapPanel>
       <TextBlock x:Name="ContextStatus" Text="等待已验证课堂会话。" Foreground="#56657A" TextWrapping="Wrap" Margin="0,0,0,10" />
       <TextBox x:Name="ContextNarrative" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="160" VerticalScrollBarVisibility="Auto" Padding="12" BorderBrush="#E0E2E8" />
      </StackPanel>
     </TabItem>
    </TabControl>
   </Grid>
  </TabItem>
  <TabItem Header="上课模式" FontSize="16" x:Name="ClassroomWorkspaceTab">
   <Grid Background="#F5F5F7" Margin="0,14,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="14">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
     <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="课堂工作区" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="ClassroomStatus" Text="常驻模式" VerticalAlignment="Center" FontSize="13" Margin="0,6,12,0" TextWrapping="Wrap" />
     </StackPanel>
     <Button x:Name="ToggleClassroom" Content="开启上课模式" Grid.Column="1" VerticalAlignment="Center" />
    </Grid>
    <Border x:Name="ClassroomGate" Grid.Row="1" Background="White" CornerRadius="12" Padding="28" VerticalAlignment="Top">
     <StackPanel>
      <TextBlock Text="开始一堂课" FontSize="22" Margin="0,0,0,12" />
      <TextBlock Text="现场采集、视觉词表和笔记AI都在这个工作区。&#10;点击上方“开启上课模式”后选择功能；笔记AI仍需单独启动。" TextWrapping="Wrap" FontSize="15" Foreground="#72727B" LineHeight="25" />
     </StackPanel>
    </Border>
    <TabControl x:Name="ClassroomTabs" Grid.Row="1" BorderThickness="0" Padding="0" Visibility="Collapsed">
     <TabItem Header="现场采集" x:Name="ClassroomCameraTab" Visibility="Collapsed">
      <ContentControl x:Name="CameraHost" />
     </TabItem>
     <TabItem Header="视觉词表" x:Name="ClassroomVisualTab" Visibility="Collapsed">
      <ContentControl x:Name="VocabularyHost" />
     </TabItem>
     <TabItem Header="笔记AI" x:Name="ClassroomNotesTab" Visibility="Collapsed">
      <Grid TextElement.FontWeight="Normal">
       <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
       <ScrollViewer x:Name="NotesSettingsScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18" MaxWidth="860" HorizontalAlignment="Stretch">
         <TextBlock Text="第五学期 · 课堂笔记维护" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
         <TextBlock Text="随课堂讲授补充知识，随PPT变化衔接笔记。" Foreground="#72727B" TextWrapping="Wrap" Margin="0,0,0,18" />
         <TextBlock Text="笔记目录" />
         <TextBox x:Name="NotesRoot" IsReadOnly="False" Padding="10" FontSize="13" BorderThickness="1" BorderBrush="#E0E2E8" Margin="0,7,0,14" />
         <TextBlock Text="本节课定位（可选：课程、章节或笔记路径）" />
         <TextBox x:Name="NotesLesson" IsReadOnly="False" Padding="10" FontSize="13" BorderThickness="1" BorderBrush="#E0E2E8" Margin="0,7,0,14" />
         <TextBlock Text="维护方式" />
         <ComboBox x:Name="NotesStrategy" SelectedIndex="0" Margin="0,7,0,14" MinHeight="32">
          <ComboBoxItem Content="自动识别：沿PPT补充，或先整理后接PPT" Tag="auto" />
          <ComboBoxItem Content="按现有PPT图片骨架补充" Tag="scaffold" />
          <ComboBoxItem Content="先建笔记，后续与PPT衔接" Tag="draft" />
         </ComboBox>
         <TextBlock Text="维护要求" />
         <TextBox x:Name="NotesDescription" IsReadOnly="False" AcceptsReturn="True" MinHeight="86" MaxHeight="180" Padding="10" FontSize="14" BorderThickness="1" BorderBrush="#E0E2E8" Margin="0,7,0,14" />
         <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
           <ColumnDefinition />
           <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="已有维护会话" />
           <ComboBox x:Name="NotesSession" DisplayMemberPath="Label" SelectedValuePath="id" MinHeight="34" Margin="0,7,0,0" />
          </StackPanel>
          <Button x:Name="ReloadNotesSessions" Grid.Column="1" Content="刷新会话" VerticalAlignment="Bottom" />
         </Grid>
         <TextBlock Text="维护模型" />
         <ComboBox x:Name="NotesModel" DisplayMemberPath="label" SelectedValuePath="id" MinHeight="32" Margin="0,7,0,14" />
         <TextBlock Text="维护所选课程笔记及相关词条，保留原始材料。" Foreground="#72727B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
        </StackPanel>
       </ScrollViewer>
       <Border Grid.Row="1" Background="White" BorderBrush="#ECEEF2" BorderThickness="0,1,0,0">
        <StackPanel Margin="22,12" MaxWidth="860">
         <StackPanel Orientation="Horizontal">
          <Button x:Name="StartNotes" Content="启动笔记维护" Margin="0,0,8,0" Background="#292D35" Foreground="White" />
          <Button x:Name="PauseNotes" Content="停止笔记维护" Margin="0,0,8,0" />
          <Button x:Name="SaveNotesSettings" Content="保存配置" Margin="0" />
         </StackPanel>
         <TextBlock x:Name="NotesStatus" Text="未启用；配置不会自动派工。" Foreground="#56657A" Margin="0,9,0,0" TextWrapping="Wrap" />
        </StackPanel>
       </Border>
      </Grid>
     </TabItem>
    </TabControl>
   </Grid>
  </TabItem>
 </TabControl>
</Grid>
