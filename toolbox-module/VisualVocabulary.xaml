<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="VocabularyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" AllowDrop="True"><Grid Margin="18,14" TextElement.FontWeight="Normal">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="500"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,10"><TextBlock Text="视觉试验场" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="三张用户选图 · 每次手动执行 · 原答统一记录 · 按各自标准核对。" FontSize="12" Foreground="#72727B" Margin="0,3,0,0"/></StackPanel>
 <StackPanel Grid.Row="1" Margin="0,0,0,12"><WrapPanel><ComboBox x:Name="Cases" DisplayMemberPath="label" Width="215" MinHeight="34" Margin="0,0,8,6"/><Button x:Name="PickImage" Content="选择图片" Margin="0,0,8,6"/><Button x:Name="PasteImage" Content="粘贴截图" Margin="0,0,12,6"/><ComboBox x:Name="TaskMode" Width="130" SelectedIndex="0" Margin="0,0,8,6"><ComboBoxItem Content="文字识别 OCR"/><ComboBoxItem Content="图形与结构"/></ComboBox><ComboBox x:Name="Models" DisplayMemberPath="label" SelectedValuePath="id" Width="260" MinHeight="34" Margin="0,0,6,6" VerticalContentAlignment="Center"/><Button x:Name="Run" Content="运行测试" Background="#292D35" Foreground="White" Margin="0,0,6,6" IsEnabled="False"/><Button x:Name="Cancel" Content="取消" IsEnabled="False" Margin="0,0,0,6"/><Button x:Name="ReloadModels" Content="刷新模型" Background="Transparent" Foreground="#72727B" Margin="12,0,0,6"/><Button x:Name="ConfigureModels" Content="模型接入设置" Margin="8,0,0,6"/></WrapPanel><StackPanel><TextBlock x:Name="SuiteStatus" Text="正在读取三张图片与答案状态" TextWrapping="Wrap" Foreground="#596476" Margin="0,0,0,6"/><CheckBox x:Name="Cache" IsChecked="False" Content="查看缓存（正式实验默认重新执行）" Margin="0,0,0,5"/><TextBlock Text="本地OCR不上传；云端上传当前图片并计费，取消后在途请求仍可能计费。" Foreground="#72727B" FontSize="12" TextWrapping="Wrap"/></StackPanel></StackPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#F7F8FA" BorderBrush="#E2E5EB" BorderThickness="1" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="ImageName" Text="原图 · 拖入图片或粘贴截图" Foreground="#596476" FontSize="12" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/><Grid Grid.Row="1"><TextBlock x:Name="EmptyImage" Text="从一张图片开始" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8A919D" FontSize="20"/><Viewbox x:Name="ImageFit" Stretch="Uniform"><Grid x:Name="ImageSurface"><Image x:Name="Preview"/><Canvas x:Name="Markers" IsHitTestVisible="False"/></Grid></Viewbox></Grid></Grid></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,9"><TextBlock x:Name="ResultMeta" Text="选择模型后，点击提取词表" Foreground="#30343B" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ResultStats" Foreground="#72727B" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
   <TabControl Grid.Row="1" x:Name="AnswerTabs" Background="White" BorderBrush="#E2E5EB">
    <TabItem Header="条目与定位">   <DataGrid x:Name="Words" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E2E5EB" BorderThickness="1" Background="White" RowHeaderWidth="0" FontSize="14" EnableRowVirtualization="True" SelectionMode="Single" HorizontalGridLinesBrush="#EEF0F3" MinRowHeight="28"><DataGrid.Resources><Style TargetType="DataGridCell"><Setter Property="Padding" Value="5,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="字符 / 行组" Binding="{Binding text}" Width="*"/><DataGridTextColumn Header="模型类别" Binding="{Binding KindLabel}" Width="85"/><DataGridTextColumn Header="核对" Binding="{Binding ReviewLabel}" Width="70"/></DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="模型答案"><TextBox x:Name="FullText" IsReadOnly="True" TextWrapping="Wrap" Padding="9" FontSize="14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></TabItem>
    <TabItem Header="原始输出"><TextBox x:Name="RawText" IsReadOnly="True" TextWrapping="Wrap" Padding="9" FontSize="13" VerticalScrollBarVisibility="Auto"/></TabItem>
    <TabItem Header="标准与评分"><TextBox x:Name="Scoring" IsReadOnly="True" TextWrapping="Wrap" Padding="9" FontSize="13" VerticalScrollBarVisibility="Auto"/></TabItem>
   </TabControl>
  </Grid>
 </Grid>
 <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,5"/><TextBlock x:Name="Status" Text="未开始 · 识别结果未经人工验证" FontSize="12" Foreground="#596476" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CopyResult" Content="复制结果" IsEnabled="False" Padding="9,5" MinHeight="28"/><Button x:Name="OpenLedger" Content="实验总记录" Padding="9,5" MinHeight="28"/><Button x:Name="OpenResults" Content="结果目录" Padding="9,5" MinHeight="28"/></StackPanel></Grid>
</Grid></ScrollViewer>
